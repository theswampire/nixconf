+    fn querytype_of_ident(
+        &self,
+        ident: &Identifier,
+        prog: &mut SockeyeProgram,
+    ) -> Option<String> {
+        if ident.defined_at.is_none() {
+            return Some("not defined".to_string());
+        }
+        let loc = ident.defined_at.clone().unwrap();
+        match loc {
+            sockeye::ast::Location::Generated => {
+                Some("something generated".to_string())
+            }
+            sockeye::ast::Location::Builtin => {
+                Some("something builtin".to_string())
+            }
+            sockeye::ast::Location::InSourceFile { file_index, range } => {
+                let ident =
+                    prog.lookup_identifier_by_offset(file_index, range.start);
+                if ident.is_none() {
+                    return Some("definition nöd gfunde".to_string());
+                }
+                let ident = ident.unwrap();
+                let def_loc = ident.location;
+
+                match prog.lookup_type_by_offset(
+                    def_loc.extract_file_index(),
+                    def_loc.extract_range().start,
+                ) {
+                    Some(p) => match p {
+                        sockeye::ast::PartialFoundType::MatchingIdent => {
+                            Some(format!("type zum {} nöd gfunde", ident.inner))
+                        }
+                        sockeye::ast::PartialFoundType::FoundType(
+                            annotated,
+                        ) => Some(format!(
+                            "{}: {}",
+                            ident.inner,
+                            annotated.to_string()
+                        )),
+                        sockeye::ast::PartialFoundType::FoundModule(_i) => {
+                            Some(format!("module {}", ident.inner))
+                        }
+                        sockeye::ast::PartialFoundType::FoundInterface => {
+                            Some(format!("interface {}", ident.inner))
+                        }
+                        sockeye::ast::PartialFoundType::FoundReference(s) => {
+                            Some(format!("reference {}", s))
+                        }
+                        sockeye::ast::PartialFoundType::FoundReferenceArray(
+                            annotated,
+                            annotated1,
+                        ) => Some(format!(
+                            "{}: Array<{}, {}>",
+                            ident.inner,
+                            annotated.to_string(),
+                            annotated1.to_string()
+                        )),
+                        sockeye::ast::PartialFoundType::FoundReferenceState(
+                            annotated,
+                        ) => Some(format!(
+                            "{}: State<{}>",
+                            ident.inner,
+                            annotated.to_string()
+                        )),
+                        sockeye::ast::PartialFoundType::FoundFnType(
+                            items,
+                            annotated,
+                        ) => Some(format!(
+                            "fn {}({}) -> {}",
+                            ident.inner,
+                            items.iter().fold(String::new(), |acc, (i, t)| {
+                                format!(
+                                    "{}{}: {}, ",
+                                    acc,
+                                    i.inner,
+                                    t.to_string()
+                                )
+                            }),
+                            annotated.to_string()
+                        )),
+                        sockeye::ast::PartialFoundType::FoundArgType(
+                            annotated,
+                        ) => Some(format!(
+                            "{}: {}",
+                            ident.inner,
+                            annotated.to_string()
+                        )),
+                    },
+                    None => Some("type nöd gfunde".to_string()),
+                }
+            }
+        }
+    }
+
+    fn handle_hover(
+        &mut self,
+        uri: &Uri,
+        line: u32,
+        col: u32,
+    ) -> Option<Hover> {
+        let path = sockeye::util::normalized_file_path(&uri_to_path(uri));
+        let prog = self.open_files.get_mut(uri)?;
+        let offset = prog.path_and_line_col_to_offset(&path, line, col)?;
+        let file_index = prog.source_paths.iter().position(|p| p == &path)?;
+        let ident = prog.lookup_identifier_by_offset(file_index, offset)?;
+
+        let mut prog2 = prog.clone();
+        let desc = self.querytype_of_ident(&ident, &mut prog2);
+
+        match desc {
+            Some(s) => Some(Hover {
+                contents: HoverContents::Scalar(MarkedString::LanguageString(
+                    lsp_types::LanguageString {
+                        value: s,
+                        language: "rust".to_string(),
+                    },
+                )),
+                range: None,
+            }),
+            None => {
+                eprintln!("oh noo");
+                None
+            }
+        }
+    }
+
     fn handle_message(&mut self, msg: Message) {
         use Message::*;
         match msg {
@@ -164,6 +293,22 @@ impl SockeyeLanguageServer {
                             error: None,
                         }))
                         .unwrap();
+                } else if r.method == "textDocument/hover" {
+                    let p: HoverParams =
+                        serde_json::from_value(r.params).unwrap();
+                    let uri = p.text_document_position_params.text_document.uri;
+                    let line = p.text_document_position_params.position.line;
+                    let col =
+                        p.text_document_position_params.position.character;
+                    let result = self.handle_hover(&uri, line, col);
+                    self.connection
+                        .sender
+                        .send(Response(lsp_server::Response {
+                            id: r.id,
+                            result: Some(serde_json::to_value(result).unwrap()),
+                            error: None,
+                        }))
+                        .unwrap();
                 }
             }
             _ => {}

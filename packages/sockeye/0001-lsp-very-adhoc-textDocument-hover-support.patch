 src/bin/sockeye-analyzer.rs | 147 +++++++++++++++++++++++++-
 2 files changed, 347 insertions(+), 1 deletion(-)

diff --git a/src/ast.rs b/src/ast.rs
index db77ebb..9a0b091 100644
--- a/src/ast.rs
+++ b/src/ast.rs
@@ -1598,6 +1598,193 @@ impl AstTransformer for FindIdentifierByLocation {
     }
 }
 
+pub enum PartialFoundType {
+    MatchingIdent,
+    FoundType(Type),
+    FoundModule(Identifier),
+    FoundInterface,
+    FoundReference(String),
+    FoundReferenceArray(Type, Type),
+    FoundReferenceState(Type),
+    FoundFnType(Vec<(Identifier, Type)>, Type),
+    FoundArgType(Type),
+}
+struct FindTypeByDefinitionLocation {
+    query_file_index: usize,
+    query_offset: usize,
+    result: Option<PartialFoundType>,
+}
+impl AstTransformer for FindTypeByDefinitionLocation {
+    fn transform_ident(&mut self, i: &mut Identifier) {
+        if i.location
+            .contains_position(self.query_file_index, self.query_offset)
+            == Some(true)
+        {
+            self.result = Some(PartialFoundType::MatchingIdent)
+        }
+    }
+
+    fn skip_node<T>(&self, _node: &Annotated<T>) -> bool {
+        match self.result {
+            Some(PartialFoundType::MatchingIdent) => false,
+            Some(_) => true,
+            None => false,
+        }
+    }
+
+    fn pre_type(&mut self, ty: &mut Type) {
+        if let Some(PartialFoundType::MatchingIdent) = self.result {
+            self.result = Some(PartialFoundType::FoundType(ty.clone()))
+        }
+    }
+
+    fn transform_toplevel_def(&mut self, def: &mut ToplevelDef) {
+        if self.skip_node(def) {
+            return;
+        }
+        use ToplevelDefKind::*;
+        match &mut def.inner {
+            Include(_, _) => {}
+            ConstantDef(name, otp, rhs) => {
+                self.transform_global_const(name, otp, rhs);
+            }
+            TypeAlias(name, ty) => {
+                self.transform_ident(name);
+                self.transform_type(ty)
+            }
+            ModuleDef(m) => {
+                self.transform_ident(&mut m.name);
+                if let Some(PartialFoundType::MatchingIdent) = self.result {
+                    if !m.name.starts_with("Global_fn_mod__") {
+                        self.result =
+                            Some(PartialFoundType::FoundModule(m.name.clone()));
+                        return;
+                    }
+                    self.result = None;
+                }
+                for (iname, mref) in m.instances.iter_mut() {
+                    self.transform_instance(iname, mref);
+                }
+                for (cname, otp, rhs) in m.consts.iter_mut() {
+                    self.transform_module_const(cname, otp, rhs);
+                }
+                for (hdr, body) in m.functions.iter_mut() {
+                    self.transform_module_function(hdr, body);
+                }
+                for (cname, mref) in m.callees.iter_mut() {
+                    self.transform_callee(cname, mref);
+                }
+                for (src, tgt) in m.connections.iter_mut() {
+                    self.transform_connection(src, tgt);
+                }
+            }
+            InterfaceDef(name, is) => {
+                self.transform_ident(name);
+                if let Some(PartialFoundType::MatchingIdent) = self.result {
+                    self.result = Some(PartialFoundType::FoundInterface);
+                    return;
+                }
+                for hdr in is {
+                    self.transform_fn_header(hdr);
+                }
+            }
+            GlobalFnDef(hdr, body) => {
+                self.transform_global_function(hdr, body);
+            }
+        }
+    }
+
+    fn transform_type(&mut self, ty: &mut Type) {
+        if self.skip_node(ty) {
+            return;
+        }
+        self.pre_type(ty);
+        use TypeKind::*;
+        match &mut ty.inner {
+            Unit => {}
+            Bool => {}
+            Int => {}
+            Enum(vs) => {
+                for v in vs {
+                    self.transform_ident(v);
+                    if let Some(PartialFoundType::MatchingIdent) = self.result {
+                        self.result =
+                            Some(PartialFoundType::FoundType(ty.clone()));
+                        return;
+                    }
+                }
+            }
+            BitInt(_) => {}
+            Vec(ty, _n) => self.transform_type(ty),
+            Record(fs) => {
+                for field in fs {
+                    self.pre_record_type_field(field);
+                    self.transform_ident(&mut field.0);
+                    self.transform_type(&mut field.1);
+                    self.post_record_type_field(field);
+                }
+            }
+            Reference(name) => self.transform_ident(name),
+        }
+        self.post_type(ty);
+    }
+
+    fn transform_module_reference(&mut self, mref: &mut ModuleReference) {
+        match &mut mref.inner {
+            ModuleReferenceKind::UserDefined(r) => {
+                if let Some(PartialFoundType::MatchingIdent) = self.result {
+                    self.result = Some(PartialFoundType::FoundReference(
+                        r.inner.to_string(),
+                    ));
+                    return;
+                }
+                self.transform_ident(r);
+            }
+            ModuleReferenceKind::State(ty, expr) => {
+                if let Some(PartialFoundType::MatchingIdent) = self.result {
+                    self.result =
+                        Some(PartialFoundType::FoundReferenceState(ty.clone()));
+                    return;
+                }
+                self.transform_type(ty);
+                self.transform_expr(expr);
+            }
+            ModuleReferenceKind::Array(kty, vty) => {
+                if let Some(PartialFoundType::MatchingIdent) = self.result {
+                    self.result = Some(PartialFoundType::FoundReferenceArray(
+                        kty.clone(),
+                        vty.clone(),
+                    ));
+                    return;
+                }
+                self.transform_type(kty);
+                self.transform_type(vty);
+            }
+        }
+    }
+
+    fn transform_fn_header(&mut self, hdr: &mut FunctionHeader) {
+        self.transform_ident(&mut hdr.name);
+        if let Some(PartialFoundType::MatchingIdent) = self.result {
+            self.result = Some(PartialFoundType::FoundFnType(
+                hdr.params.clone(),
+                hdr.return_type.clone(),
+            ));
+            return;
+        }
+
+        for (pname, pty) in &mut hdr.params {
+            self.transform_ident(pname);
+            if let Some(PartialFoundType::MatchingIdent) = self.result {
+                self.result = Some(PartialFoundType::FoundArgType(pty.clone()));
+                return;
+            }
+            self.transform_type(pty)
+        }
+        self.transform_type(&mut hdr.return_type)
+    }
+}
+
 impl UserDefinedModule {
     pub fn from_members(
         name: Identifier,
@@ -1919,6 +2106,20 @@ impl SockeyeProgram {
         t.result
     }
 
+    pub fn lookup_type_by_offset(
+        &mut self,
+        query_file_index: usize,
+        query_offset: usize,
+    ) -> Option<PartialFoundType> {
+        let mut t = FindTypeByDefinitionLocation {
+            query_file_index,
+            query_offset,
+            result: None,
+        };
+        t.transform_program(self);
+        t.result
+    }
+
     pub fn lookup_toplevel_def(&self, name: &str) -> Option<&ToplevelDef> {
         self.defs.iter().find(|def| def.inner.name() == name)
     }
